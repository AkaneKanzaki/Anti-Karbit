# ==============================================================================
# KONFIGURASI ANTIKARBIT - TELEGRAM WAIFU CLAIMER BOT
# ==============================================================================
#
# Salin file ini menjadi `.env` lalu isi nilainya.
# Semua key di bawah dipakai oleh versi Rust (direktori `rust/`).

# 1. Kredensial Telegram (Dapatkan dari https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Nama file sesi di disk. Di Railway, arahkan ke dalam volume bila memakai
# salah satu, misalnya /data/waifu_claimer_session
TELEGRAM_SESSION_NAME=waifu_claimer_session

# Sesi terenkode base64 untuk deploy tanpa volume persistent.
# Hasilkan SEKALI di lokal dengan: antikarbit export-session
# Railway menghapus file .session setiap deploy, jadi isi variabel ini
# agar bot tidak meminta OTP berulang kali.
TELEGRAM_STRING_SESSION=

# Password Dashboard Web (sangat disarankan saat deploy ke cloud publik)
DASHBOARD_PASSWORD=password_rahasia_anda_disini

# 2. Reverse Image Search
# Ambang kemiripan IQDB dalam persen.
IQDB_MIN_SIMILARITY=60.0

# Ambang kemiripan Trace.moe (0.0 - 1.0, atau persen bila > 1.0).
TRACEMOE_MIN_SIMILARITY=0.85

# SauceNAO API key (opsional, gratis di https://saucenao.com/user.php).
# Kosongkan bila tidak dipakai — engine SauceNAO otomatis dilewati.
SAUCENAO_API_KEY=
SAUCENAO_MIN_SIMILARITY=70.0

# Google Lens sebagai fallback terakhir. Setiap hasilnya wajib lolos
# verifikasi AniList sebelum boleh dipakai mengklaim.
LENS_ENABLED=true

# 3. Pengaturan Klaim Game
# Perintah klaim di grup (contoh: /protecc)
CLAIM_COMMAND=/protecc

# Format nama yang dikirim:
# - 'full'  : Nama lengkap (contoh: /protecc Mikan Tsumiki)
# - 'first' : Hanya nama depan (contoh: /protecc Mikan)
# - 'both'  : Kirim nama depan dulu lalu nama lengkap
NAME_FORMAT=full

# Kata kunci pemicu dalam pesan bot game (pisahkan dengan koma)
TRIGGER_KEYWORDS=A waifu has appeared!,A husbando has appeared!,/protecc name,Add her to your harem,Add him to your harem

# Whitelist ID grup Telegram (kosongkan untuk semua grup yang dimasuki)
TARGET_CHAT_IDS=

# Jeda buatan sebelum perintah dikirim, dalam detik.
#
# PENTING untuk kecepatan: nilai ini LANGSUNG mengurangi peluang menang klaim.
# Bot mengirim /protecc secepat mungkin, dan lawan di grup juga begitu.
# Set ke 0 untuk mematikannya. Nilai lama (0.5-1.5) membuang 0,5-1,5 detik
# yang sering menentukan menang atau kalah.
MIN_DELAY_SECONDS=0
MAX_DELAY_SECONDS=0

# 4. Verifikasi Klaim & Auto-Retry
# Batas waktu menunggu balasan game bot. Verifikasi berjalan di latar
# belakang, jadi nilai ini TIDAK memblokir pemrosesan spawn berikutnya.
# 1 detik terlalu pendek untuk round-trip Telegram; pakai 6-10 detik.
VERIFY_TIMEOUT_SECONDS=5.0

# Batas waktu pemanggilan send_message itu sendiri. Tanpa ini, satu request
# yang macet (mis. channel tanpa access_hash) membuat task klaim menggantung
# selamanya: tidak ada klaim sukses, tidak ada klaim gagal, tidak ada log.
SEND_TIMEOUT_SECONDS=5.0

SUCCESS_KEYWORDS=now protected,added to your harem,added to your collection,is now yours,congratulations
FAIL_KEYWORDS=not quite right,wrong name,already claimed,already protecc,rip,try again

# 5. Dashboard Web
# PORT otomatis diisi oleh Railway/Heroku/Render.
PORT=8080
# WEB_HOST wajib 0.0.0.0 pada container/cloud (Railway/Docker) agar bisa diakses proxy.
# JANGAN diisi domain publik (misal antikarbit.up.railway.app) atau localhost.
WEB_HOST=0.0.0.0
